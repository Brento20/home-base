# Copy to .env and fill in from Supabase › Project Settings › API.
# Leave both empty to run on in-memory sample data.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: a Claude API key (platform.claude.com › API keys) turns on the AI helpers.
# Leave empty and they hide; every form still works by hand.
ANTHROPIC_API_KEY=

# Optional: locks secret notes (Wi-Fi passwords, door codes) in the database, so they're
# unreadable without this key. Make one with: openssl rand -base64 32
# Keep a copy somewhere safe. Lose it and locked notes can't be opened.
NOTES_KEY=
