# Copy to .env and fill in from Supabase › Project Settings › API.
# Leave both empty to run on in-memory sample data.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: a Claude API key (platform.claude.com › API keys) turns on the AI helpers.
# Leave empty and they hide; every form still works by hand.
ANTHROPIC_API_KEY=
