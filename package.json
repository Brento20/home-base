{
	"name": "home-base",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"preview:cf": "vite build && wrangler dev",
		"deploy": "vite build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:link": "supabase login && supabase link --project-ref rpjqyjufjyzzkbikxtsa",
		"db:mark-applied": "node tools/mark-migrations-applied.mjs",
		"db:status": "supabase migration list --remote",
		"db:new": "supabase migration new",
		"db:push": "supabase db push --remote",
		"push:keys": "node tools/vapid-keys.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"supabase": "^3.2.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.0",
		"vitest": "^5.1.1",
		"wrangler": "^4.164.0"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.0",
		"ical.js": "^2.2.1",
		"uqr": "^0.1.3"
	}
}
