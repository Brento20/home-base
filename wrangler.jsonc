// Cloudflare Workers deploy settings. `npm run build` writes the worker and static files into
// .svelte-kit/cloudflare; `npm run deploy` builds and uploads them.
//
// SUPABASE_URL lives here because every deploy replaces plain variables with this file's `vars`.
// SUPABASE_PUBLISHABLE_KEY is a secret, set once in the Cloudflare dashboard (Workers ›
// home-base › Settings › Variables and Secrets); secrets survive deploys and stay out of git.
// ANTHROPIC_API_KEY (optional, turns on the AI helpers) is a secret too, set the same way.
// For a local `npm run preview:cf`, put them in .dev.vars (ignored by git).
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "home-base",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		// Serve /offline.html as it is. Cloudflare would otherwise redirect it to /offline, and the
		// service worker can't use a redirected response as the page it shows offline.
		"html_handling": "none"
	},
	"vars": {
		"SUPABASE_URL": "https://rpjqyjufjyzzkbikxtsa.supabase.co"
	},
	// Caps AI calls at 10 a minute per person (src/lib/server/ai.ts). Cloudflare allows a period
	// of 10 or 60 seconds; namespace_id is any number unique to this account.
	"ratelimits": [
		{
			"name": "AI_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"observability": {
		"enabled": true
	}
}
